    font-weight: 700;
}

QLabel#sectionHintLabel,
QLabel#testHintLabel,
QLabel#questionLabel {
    color: #475569;
    font-size: 14px;
}

QPushButton#loadCoursesButton,
QPushButton#enrollButton,
QPushButton#loadTestButton,
QPushButton#submitTestButton {
    min-height: 44px;
    border: none;
    border-radius: 14px;
    padding: 0 18px;
    background-color: #0f172a;
    color: white;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#loadCoursesButton:hover,
QPushButton#enrollButton:hover,
QPushButton#loadTestButton:hover,
QPushButton#submitTestButton:hover {
    background-color: #1e293b;
}

QPushButton#enrollButton {
    background-color: #2563eb;
}

QPushButton#enrollButton:hover {
    background-color: #1d4ed8;
}

QListWidget,
QComboBox {
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    background-color: #ffffff;
    color: #0f172a;
    padding: 10px;
    font-size: 14px;
}</string>
