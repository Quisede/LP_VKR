    font-weight: 700;
}

QLabel#brandCaptionLabel {
    color: #94a3b8;
    font-size: 13px;
}

QPushButton#coursesButton,
QPushButton#testButton {
    min-height: 46px;
    border: none;
    border-radius: 14px;
    padding: 0 16px;
    text-align: left;
    background-color: rgba(148, 163, 184, 0.14);
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#coursesButton:hover,
QPushButton#testButton:hover {
    background-color: rgba(148, 163, 184, 0.24);
}

QFrame#contentFrame {
    background-color: transparent;
}

QLabel#pageTitleLabel {
    color: #0f172a;
    font-size: 30px;
    font-weight: 700;
}

QLabel#pageSubtitleLabel {
    color: #475569;
    font-size: 14px;
}

QLabel#statusLabel {
    color: #0f172a;
    background-color: #dbeafe;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 13px;
}

QFrame#pageCard,
QFrame#testCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
}

QLabel#sectionTitleLabel,
QLabel#testSectionTitleLabel {
    color: #0f172a;
