  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #f8fafc;
}

QWidget#centralwidget {
    background-color: #f8fafc;
}

QFrame#sidebarFrame {
    background-color: #0f172a;
    border-radius: 24px;
}

QLabel#brandLabel {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
}

QLabel#brandCaptionLabel {
    color: #94a3b8;
    font-size: 13px;
}

QPushButton#homeButton,
QPushButton#coursesButton,
QPushButton#testButton,
QPushButton#resultsButton,
QPushButton#profileButton {
    min-height: 46px;
    border: none;
    border-radius: 14px;
    padding: 0 16px;
    text-align: left;
    background-color: rgba(148, 163, 184, 0.14);
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#homeButton:hover,
QPushButton#coursesButton:hover,
QPushButton#testButton:hover,
QPushButton#resultsButton:hover,
QPushButton#profileButton:hover {
    background-color: rgba(148, 163, 184, 0.24);
}

QPushButton#homeButton:checked,
QPushButton#coursesButton:checked,
QPushButton#testButton:checked,
QPushButton#resultsButton:checked,
QPushButton#profileButton:checked {
    background-color: #2563eb;
    color: #ffffff;
}

QPushButton#logoutButton {
    min-height: 46px;
    border: 1px solid rgba(248, 113, 113, 0.35);
    border-radius: 14px;
    padding: 0 16px;
    text-align: left;
    background-color: rgba(127, 29, 29, 0.28);
    color: #fecaca;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#logoutButton:hover {
    background-color: rgba(185, 28, 28, 0.4);
}

QFrame#contentFrame {
    background-color: transparent;
}

QLabel#pageTitleLabel {
    color: #0f172a;
    font-size: 30px;
    font-weight: 700;
}

QLabel#pageSubtitleLabel {
    color: #475569;
    font-size: 14px;
}

QLabel#statusLabel {
    color: #0f172a;
    background-color: #dbeafe;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 13px;
}

QFrame#pageCard,
QFrame#testCard,
QFrame#profileCard,
QFrame#courseDetailCard,
QFrame#moduleCard,
QFrame#moduleCard_2,
QFrame#moduleCard_3,
QFrame#moduleCard_4,
QFrame#moduleCard_5,
QFrame#moduleCard_6,
QFrame#moduleCard_7 {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
}

QLabel#sectionTitleLabel,
QLabel#testSectionTitleLabel,
QLabel#profileSectionTitleLabel,
QLabel#courseDetailTitleLabel {
    color: #0f172a;
    font-size: 20px;
    font-weight: 700;
}

QLabel#sectionHintLabel,
QLabel#testHintLabel,
QLabel#profileHintLabel,
QLabel#questionLabel,
QLabel#courseDetailDescriptionLabel,
QLabel#moduleTitleLabel,
QLabel#moduleDescriptionLabel {
    color: #475569;
    font-size: 14px;
}

QPushButton#enrollButton,
QPushButton#loadTestButton,
QPushButton#submitTestButton,
QPushButton#backToCoursesButton,
QPushButton#cardActionButton,
QPushButton#cardAccentButton {
    min-height: 44px;
    border: none;
    border-radius: 14px;
    padding: 0 18px;
    background-color: #0f172a;
    color: white;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#enrollButton:hover,
QPushButton#loadTestButton:hover,
QPushButton#submitTestButton:hover,
QPushButton#backToCoursesButton:hover,
QPushButton#cardActionButton:hover,
QPushButton#cardAccentButton:hover {
    background-color: #1e293b;
}

QPushButton#enrollButton,
QPushButton#cardAccentButton {
    background-color: #2563eb;
}

QPushButton#enrollButton:hover,
QPushButton#cardAccentButton:hover {
    background-color: #1d4ed8;
}

QListWidget,
QComboBox {
    border: none;
    border-radius: 16px;
    background-color: transparent;
    color: #0f172a;
    padding: 0;
    font-size: 14px;
}

QRadioButton {
    color: #0f172a;
    font-size: 15px;
    spacing: 10px;
    padding: 4px 0;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QListWidget::item {
    border: none;
}

QFrame#courseCard {
    background-color: #ffffff;
    border: 1px solid #dbe4f0;
    border-radius: 20px;
}

QFrame#courseCard:hover {
    border: 1px solid #93c5fd;
    background-color: #f8fbff;
}

QLabel#courseCardTitleLabel {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
}

QLabel#courseCardDescriptionLabel {
    color: #475569;
    font-size: 13px;
}

QLabel#courseCardHintLabel {
    color: #2563eb;
    font-size: 12px;
    font-weight: 700;
}

QFrame#profileInfoCard {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 18px;
}

QLabel#profileKeyLabel {
    color: #1e3a8a;
    font-size: 13px;
    font-weight: 700;
}

QLabel#profileNameValueLabel,
QLabel#profileRoleValueLabel,
QLabel#profileTokenValueLabel {
    color: #0f172a;
    font-size: 14px;
}</string>
