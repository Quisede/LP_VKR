FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    qt6-base-dev \
    qt6-base-dev-tools \
    qt6-tools-dev-tools \
    libgl1-mesa-dev \
    libegl1 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libx11-xcb1 \
    libdbus-1-3 \
    xvfb \
    dbus-x11 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . /workspace

RUN chmod +x /workspace/scripts/qt-client-docker-entrypoint.sh

ENTRYPOINT ["/workspace/scripts/qt-client-docker-entrypoint.sh"]
CMD ["build"]
